{% extends "base.html.j2" %}
{% from "_macros.html.j2" import status_badge, progress_bar, task_row, pagination %}
{% block title %}xeHentai{% endblock %}

{% block content %}
<div class="space-y-6">
    <div class="flex items-center justify-between">
        <h1 class="text-2xl font-bold text-gray-900">Tasks</h1>
    </div>

    <!-- Filters -->
    <div class="bg-white rounded-lg shadow-sm border p-4 space-y-3">
        <form id="task-filter-form" hx-get="/tasks" hx-target="#task-table-container" hx-trigger="change from:#state-filter, change from:#order-by, change from:#order-dir, submit" hx-indicator="#search-spinner">
            <!-- Row 1: State + GID + Sort + Filter -->
            <div class="flex gap-3 flex-wrap items-end">
                <div>
                    <label class="block text-xs text-gray-500 mb-1">State</label>
                    <details id="state-filter" class="relative">
                        <summary class="cursor-pointer rounded-lg border border-gray-300 px-3 py-2 text-sm bg-white select-none">
                            {% if current_states_list %}
                            States ({{ current_states_list|length }})
                            {% else %}
                            All States
                            {% endif %}
                        </summary>
                        <div class="absolute z-10 mt-1 bg-white border border-gray-300 rounded-lg shadow-lg p-3 w-60 max-h-80 overflow-y-auto">
                            {% for val, name in available_states %}
                            <label class="flex items-center gap-2 text-sm py-1 cursor-pointer hover:bg-gray-50">
                                <input type="checkbox" name="states" value="{{ val }}" class="rounded"
                                       {% if val|string in current_states_list %}checked{% endif %}>
                                {{ name }}
                            </label>
                            {% endfor %}
                        </div>
                    </details>
                </div>
                <div>
                    <label class="block text-xs text-gray-500 mb-1">GID</label>
                    <input type="text" name="gid" placeholder="Search by GID..." value="{{ current_gid }}"
                           class="rounded-lg border border-gray-300 px-3 py-2 text-sm">
                </div>
                <div>
                    <label class="block text-xs text-gray-500 mb-1">Sort By</label>
                    <select id="order-by" name="order_by" class="rounded-lg border border-gray-300 px-3 py-2 text-sm">
                        <option value="gid" {% if current_order_by == 'gid' %}selected{% endif %}>GID</option>
                        <option value="updated_at" {% if current_order_by == 'updated_at' %}selected{% endif %}>Updated At</option>
                    </select>
                </div>
                <div>
                    <label class="block text-xs text-gray-500 mb-1">Direction</label>
                    <select id="order-dir" name="order_dir" class="rounded-lg border border-gray-300 px-3 py-2 text-sm">
                        <option value="DESC" {% if current_order_dir == 'DESC' %}selected{% endif %}>Newest First</option>
                        <option value="ASC" {% if current_order_dir == 'ASC' %}selected{% endif %}>Oldest First</option>
                    </select>
                </div>
                <div>
                    <button type="submit" class="px-4 py-2 bg-gray-100 text-gray-700 text-sm font-medium rounded-lg hover:bg-gray-200">
                        Filter
                    </button>
                </div>
            </div>
            <!-- Row 2: Search (full width) -->
            <div class="mt-4">
                <label class="block text-xs text-gray-500 mb-1">Search</label>
                <div class="flex items-center gap-2">
                    <input type="search" name="f_search" placeholder="title / tags (space-separated, ALL must match)..." value="{{ current_q|e }}"
                           autocomplete="on"
                           class="flex-1 rounded-lg border border-gray-300 px-3 py-2 text-sm">
                    <span id="search-spinner" class="htmx-indicator text-sm text-gray-400">searching...</span>
                </div>
            </div>
        </form>
    </div>

    <!-- Task Table -->
    <div id="task-table-container">
        {% if retryable_guids %}
        <div class="flex justify-end mb-2">
            <button id="retry-page-btn" data-retry-guids='{{ retryable_guids|tojson }}'
                    class="px-4 py-2 bg-orange-100 text-orange-700 text-sm font-medium rounded-lg hover:bg-orange-200">
                Retry Page ({{ retryable_guids|length }})
            </button>
        </div>
        {% endif %}
        <div class="bg-white rounded-lg shadow-sm border overflow-hidden">
            <table class="w-full">
                <thead>
                    <tr class="text-left text-sm text-gray-500 border-b bg-gray-50">
                        <th class="py-3 px-4 font-medium">GID</th>
                        <th class="py-3 px-4 font-medium">Title</th>
                        <th class="py-3 px-4 font-medium">State</th>
                        <th class="py-3 px-4 font-medium">Progress</th>
                        <th class="py-3 px-4 font-medium">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    {% if tasks %}
                    {% for t in tasks %}
                    {{ task_row(t) }}
                    {% endfor %}
                    {% else %}
                    <tr>
                        <td colspan="5" class="py-8 text-center text-gray-400">No tasks found</td>
                    </tr>
                    {% endif %}
                </tbody>
            </table>
        </div>
        {{ pagination(total, offset, limit, '/tasks', current_states, current_gid, current_q_encoded, current_order_by, current_order_dir) }}
    </div>
</div>
{% endblock %}

{% block scripts %}
<script>
initWebSocket();

// Retry all retryable tasks on the current page.
// Event delegation survives htmx partial swaps (the button lives inside
// #task-table-container which gets re-rendered).
document.addEventListener("click", async function(e) {
    var btn = e.target.closest("#retry-page-btn");
    if (!btn) return;
    var guids = JSON.parse(btn.dataset.retryGuids || "[]");
    if (!guids.length) return;
    btn.disabled = true;
    var origText = btn.textContent;
    btn.textContent = "Retrying...";
    try {
        var resp = await fetch("/api/tasks/retry", {
            method: "POST",
            headers: {"Content-Type": "application/json"},
            body: JSON.stringify({guids: guids})
        });
        if (!resp.ok) {
            var err = await resp.json().catch(function() { return {}; });
            throw new Error(err.detail || ("HTTP " + resp.status));
        }
        showToast("Retried " + guids.length + " task(s)", "success");
        // Re-fetch with the CURRENT filter form values (states/gid/search/
        // sort). htmx partial swaps never update the address bar, so
        // window.location.search can't be trusted here — re-submitting the
        // form serializes exactly what the user has selected.
        var form = document.getElementById("task-filter-form");
        if (form) {
            form.requestSubmit();
        } else {
            htmx.ajax("GET", "/tasks", {target: "#task-table-container", swap: "outerHTML"});
        }
    } catch (err) {
        showToast("Retry failed: " + err.message, "error");
        btn.disabled = false;
        btn.textContent = origText;
    }
});

// Keep the multi-select summary label in sync when checkboxes change.
document.addEventListener("change", function(e) {
    if (e.target.matches('#state-filter input[name="states"]')) {
        var n = document.querySelectorAll('#state-filter input[name="states"]:checked').length;
        var summary = document.querySelector("#state-filter summary");
        if (summary) summary.textContent = n ? "States (" + n + ")" : "All States";
    }
});

function _updateRowProgress(data) {
    var row = document.getElementById("task-row-" + data.guid);
    if (!row) return;
    var bar = row.querySelector(".task-progress-bar div");
    var label = row.querySelector(".task-progress-label");
    if (bar && label && data.total > 0) {
        var pct = Math.round(data.done / data.total * 100);
        bar.style.width = pct + "%";
        label.textContent = data.done + "/" + data.total + " (" + pct + "%)";
    }
}

function _refreshRow(guid) {
    var row = document.getElementById("task-row-" + guid);
    if (row) {
        htmx.ajax("GET", "/tasks/" + guid + "/row", {target: row, swap: "outerHTML"});
    }
}

// frequent progress events: DOM-only update
window.addEventListener("ws:task_progress", function(e) {
    if (e.detail) _updateRowProgress(e.detail);
});

// state transitions: server re-render the row (state badge + action buttons change)
window.addEventListener("ws:task_state_change", function(e) {
    if (e.detail) _refreshRow(e.detail.guid);
});
window.addEventListener("ws:task_completed", function(e) {
    if (e.detail) {
        _refreshRow(e.detail.guid);
        if (e.detail.state === "finished") showToast("Task " + e.detail.gid + " completed!", "success");
        else showToast("Task " + e.detail.gid + " failed", "error");
    }
});
</script>
{% endblock %}
