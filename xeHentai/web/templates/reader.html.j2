{% extends "base.html.j2" %}
{% block title %}Read: {{ title or gid }} - xeHentai{% endblock %}

{# Hide the main site nav (Dashboard/Tasks/Add/Config) on the reader page #}
{% block nav %}{% endblock %}

{# Strip all main wrapper padding/width — reader uses full viewport #}
{% block main_class %}{% endblock %}

{% block head %}
<style>
#reader-hint { transition: opacity 0.3s ease-out; }
#reader-hint.dismissing { opacity: 0; pointer-events: none; }
#reader-pull-tab { background-color: rgba(156, 163, 175, 0.5); transition: top 0.3s ease; }
#reader-pull-tab:hover { background-color: rgba(107, 114, 128, 0.7); }
#reader-pull-tab.locked { background-color: rgba(59, 130, 246, 0.65); }
#reader-pull-tab.locked:hover { background-color: rgba(37, 99, 235, 0.75); }
#reader-pull-tab.shifted { top: 3.5rem; }
</style>
{% endblock %}

{% block content %}
    <!-- Reader header: floating, hides on inactivity -->
    <div id="reader-header" class="flex items-center justify-between fixed top-0 left-0 right-0 z-30 bg-white/90 backdrop-blur-sm shadow-sm px-6 py-3 transition-transform duration-300">
        <div class="flex items-center gap-4">
            <a href="/tasks/{{ guid }}" class="text-sm text-gray-500 hover:text-blue-600">&larr; Back</a>
            <h1 class="text-lg font-bold text-gray-900 truncate max-w-lg">{{ title or gid }}</h1>
        </div>
        <div class="flex items-center gap-3">
            <span id="page-counter" class="text-sm text-gray-500"></span>
            <button id="mode-toggle" onclick="toggleMode()"
                    class="px-3 py-1.5 text-sm rounded-lg border border-gray-300 hover:bg-gray-100">
                {% if scroll_mode %}Comic Mode{% else %}Scroll Mode{% endif %}
            </button>
        </div>
    </div>

{% if images %}
    <div id="reader-container" class="mx-auto {% if not scroll_mode %}max-w-4xl{% endif %}">
        {% if scroll_mode %}
            {% for img in images %}
            <div class="mb-1">
                <img src="{{ img.url }}" alt="Page {{ img.fid }}"
                     loading="lazy" class="w-full h-auto block cursor-pointer"
                     onclick="showBar()" />
            </div>
            {% endfor %}
        {% else %}
            {% for img in images %}
            <div id="page-{{ img.fid }}" class="reader-page flex flex-col items-center justify-center min-h-screen{% if loop.index0 > 0 %} hidden{% endif %}">
                <img src="{{ img.url }}" alt="Page {{ img.fid }}"
                     class="max-w-full max-h-screen object-contain cursor-pointer select-none"
                     onclick="handleImageClick(event)"
                     draggable="false" />
            </div>
            {% endfor %}
        {% endif %}
    </div>
    <!-- First-visit click zone hint overlay (full viewport, below header) -->
    <div id="reader-hint" class="fixed inset-0 z-25 hidden">
        <div class="absolute top-0 bottom-0 left-0 w-1/5 bg-black/30 flex items-center justify-center cursor-pointer"
             onclick="dismissHint()">
            <span class="text-white text-lg font-bold bg-black/50 px-4 py-2 rounded-lg select-none">◀ 上一页</span>
        </div>
        <div class="absolute top-0 bottom-0 left-[20%] right-0 bg-black/10 flex items-center justify-center cursor-pointer"
             onclick="dismissHint()">
            <span class="text-white text-lg font-bold bg-black/50 px-4 py-2 rounded-lg select-none">下一页 ▶</span>
        </div>
    </div>
    <!-- Pull-tab: toggle header visibility lock (top-left) -->
    <div id="reader-pull-tab" class="fixed top-0 left-0 z-35 w-10 h-[60px] rounded-br-lg cursor-pointer transition-colors flex items-center justify-center select-none"
         onclick="toggleHeaderLock()" title="Click to pin header">
        <span class="text-white text-xl font-bold leading-none">↑</span>
    </div>
{% else %}
    <p class="text-gray-400 text-center py-12">No images available yet.</p>
{% endif %}
{% endblock %}

{% block scripts %}
<script>
var currentPage = {{ start_page | default(1) }};
var totalPages = {{ total }};
var scrollMode = {{ 'true' if scroll_mode else 'false' }};
var winStart = {{ win_start | default(1) }};
var loadedEnd = {{ win_end | default(total) }};
var guid = "{{ guid }}";
var batchHalf = 10;
var preloading = false;

function padPage(n) {
    return String(n).padStart(totalPages.toString().length, "0");
}

function preloadNextBatch(triggerPage) {
    if (preloading || loadedEnd >= totalPages) return;
    var nextFrom = loadedEnd + 1;
    var nextTo = Math.min(loadedEnd + batchHalf, totalPages);
    if (nextFrom > nextTo) return;
    preloading = true;
    htmx.ajax("GET", "/tasks/" + guid + "/pages?from=" + nextFrom + "&to=" + nextTo, {
        target: "#reader-container",
        swap: "beforeend"
    }).then(function() {
        loadedEnd = nextTo;
        preloading = false;
        // chain next batch if still in range
        if (loadedEnd < totalPages && currentPage >= loadedEnd - batchHalf + 1) {
            preloadNextBatch(currentPage);
        }
    }).catch(function() {
        preloading = false;
    });
}

function showPage(n) {
    if (n < 1 || n > totalPages) return;
    if (!scrollMode && n >= loadedEnd - batchHalf + 1 && loadedEnd < totalPages) {
        preloadNextBatch(n);
    }
    var p = document.getElementById("page-" + padPage(n));
    if (p) {
        document.querySelectorAll(".reader-page").forEach(function(el) { el.classList.add("hidden"); });
        p.classList.remove("hidden");
        currentPage = n;
        updateNav();
        window.scrollTo({top: 0, behavior: "instant"});
    } else if (n >= 1 && n <= totalPages) {
        // missing from DOM: full reload at target page
        var url = new URL(location.href);
        url.searchParams.set("page", n);
        location.href = url.toString();
    }
}

function nextPage() { if (currentPage < totalPages) showPage(currentPage + 1); }
function prevPage() { if (currentPage > 1) showPage(currentPage - 1); }

function updateNav() {
    document.getElementById("page-counter").textContent = currentPage + " / " + totalPages;
}

function toggleMode() {
    var url = new URL(location.href);
    url.searchParams.set("scroll", scrollMode ? "0" : "1");
    location.href = url.toString();
}

document.addEventListener("keydown", function(e) {
    if (scrollMode) return;
    if (e.key === "ArrowRight" || e.key === "ArrowDown" || e.key === " ") { e.preventDefault(); nextPage(); }
    else if (e.key === "ArrowLeft" || e.key === "ArrowUp") { e.preventDefault(); prevPage(); }
});

// Click zone: left 1/5 → prev, right 4/5 → next
function handleImageClick(e) {
    if (scrollMode) { showBar(); return; }
    var rect = e.target.getBoundingClientRect();
    var xRatio = (e.clientX - rect.left) / rect.width;
    if (xRatio < 0.2) {
        prevPage();
        // Immediately hide header same as next page
        if (bar && !headerLocked) {
            if (hideTimer) clearTimeout(hideTimer);
            bar.style.transform = "translateY(-100%)";
            shiftTab(false);
        }
    } else {
        nextPage();
        // Immediately hide header on next page
        if (bar && !headerLocked) {
            if (hideTimer) clearTimeout(hideTimer);
            bar.style.transform = "translateY(-100%)";
            shiftTab(false);
        }
    }
}

// First-visit hint overlay (localStorage)
(function() {
    var HINT_KEY = "xehentai-reader-hint-shown";
    if (scrollMode || localStorage.getItem(HINT_KEY)) return;
    var hint = document.getElementById("reader-hint");
    if (!hint) return;
    hint.classList.remove("hidden");
    // Auto-dismiss after 8 seconds
    setTimeout(function() { dismissHint(); }, 8000);
})();

function dismissHint() {
    var hint = document.getElementById("reader-hint");
    if (!hint || hint.classList.contains("dismissing")) return;
    hint.classList.add("dismissing");
    setTimeout(function() { hint.classList.add("hidden"); }, 300);
    localStorage.setItem("xehentai-reader-hint-shown", "1");
}

updateNav();
if (!scrollMode && currentPage > 1) showPage(currentPage);

// Floating bar logic
var lastScrollY = 0;
var bar = document.getElementById("reader-header");
var hideTimer = null;
var headerLocked = false;

function toggleHeaderLock() {
    headerLocked = !headerLocked;
    var tab = document.getElementById("reader-pull-tab");
    if (headerLocked) {
        if (tab) tab.classList.add("locked");
        showBar();
        if (hideTimer) clearTimeout(hideTimer);
    } else {
        if (tab) tab.classList.remove("locked");
        resetHideTimer();
    }
}

function shiftTab(visible) {
    var tab = document.getElementById("reader-pull-tab");
    if (!tab) return;
    var span = tab ? tab.querySelector("span") : null;
    if (visible) {
        tab.classList.add("shifted");
        if (span) span.textContent = "↓";
    } else {
        tab.classList.remove("shifted");
        if (span) span.textContent = "↑";
    }
}

if (scrollMode && bar) {
    window.addEventListener("scroll", function() {
        var sy = window.scrollY;
        if (sy > lastScrollY && sy > 80) {
            bar.style.transform = "translateY(-100%)";
            shiftTab(false);
        } else if (sy < lastScrollY) {
            bar.style.transform = "translateY(0)";
            shiftTab(true);
        }
        lastScrollY = sy;
    }, {passive: true});
} else if (!scrollMode && bar) {
    // Comic mode: header only shows when mouse near top edge, or when locked via pull-tab
    function resetHideTimer() {
        if (headerLocked) return;
        bar.style.transform = "translateY(0)";
        shiftTab(true);
        if (hideTimer) clearTimeout(hideTimer);
        hideTimer = setTimeout(function() {
            if (!headerLocked) { bar.style.transform = "translateY(-100%)"; shiftTab(false); }
        }, 2000);
    }
    document.addEventListener("mousemove", function(e) {
        if (!headerLocked && e.clientY < 60) {
            resetHideTimer();
        }
    }, {passive: true});
    // Initial: show briefly then hide
    resetHideTimer();
}

function showBar() {
    if (bar) { bar.style.transform = "translateY(0)"; shiftTab(true); lastScrollY = window.scrollY; }
}
function hideBar() {
    if (bar && !scrollMode) {
        if (hideTimer) clearTimeout(hideTimer);
        hideTimer = setTimeout(function() {
            bar.style.transform = "translateY(-100%)";
            shiftTab(false);
        }, 2000);
    }
}
</script>
{% endblock %}
