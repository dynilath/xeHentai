{% extends "base.html.j2" %}
{% from "_macros.html.j2" import status_badge, progress_bar %}
{% block title %}{{ title or gid }} - xeHentai{% endblock %}

{% block content %}
<div class="space-y-6">
    <!-- Header -->
    <div class="flex items-start justify-between gap-4">
        <div class="min-w-0 flex-1">
            <h1 class="text-2xl font-bold text-gray-900 break-words">{{ title or gid }}</h1>
            {% if title_japanese %}
            <p class="text-sm text-gray-500 mt-1">{{ title_japanese }}</p>
            {% endif %}
            <div class="flex items-center gap-3 mt-2">
                {% if url %}
                <a href="{{ url }}" target="_blank" rel="noopener" class="text-xs text-blue-500 hover:text-blue-700 font-mono">GID: {{ gid }}</a>
                {% else %}
                <span class="text-xs text-gray-400 font-mono">GID: {{ gid }}</span>
                {% endif %}
                {{ status_badge(state, state_name, state_css) }}
            </div>
        </div>
        <div class="flex gap-2 shrink-0 flex-wrap justify-end">
            {% if state == 0 %}
            <button hx-post="/api/tasks/{{ guid }}/resume" hx-swap="none"
                    class="px-4 py-2 bg-green-600 text-white text-sm rounded-lg hover:bg-green-700">
                Resume
            </button>
            {% elif state > 0 and state < 20 %}
            <button hx-post="/api/tasks/{{ guid }}/pause" hx-swap="none"
                    class="px-4 py-2 bg-yellow-600 text-white text-sm rounded-lg hover:bg-yellow-700">
                Pause
            </button>
            {% endif %}
            {% if state < 0 %}
            <button hx-post="/api/tasks/retry" hx-ext="json-enc" hx-vals='{"guid":"{{ guid }}"}' hx-swap="none"
                    class="px-4 py-2 bg-orange-600 text-white text-sm rounded-lg hover:bg-orange-700">
                Retry
            </button>
            {% endif %}
            {% if state == 20 %}
            <a href="/tasks/{{ guid }}/read/1"
               class="px-4 py-2 bg-indigo-600 text-white text-sm rounded-lg hover:bg-indigo-700">
                Read
            </a>
            {% endif %}
            <button hx-delete="/api/tasks/{{ guid }}" hx-confirm="Delete this task?"
                    hx-on:htmx:afterRequest="window.location.href='/tasks'"
                    class="px-4 py-2 bg-red-600 text-white text-sm rounded-lg hover:bg-red-700">
                Delete
            </button>
            {% if state == 20 %}
            <a href="/api/archive/{{ gid }}"
               class="px-4 py-2 bg-gray-600 text-white text-sm rounded-lg hover:bg-gray-700">
                Download Archive
            </a>
            {% endif %}
            {% if subscribed %}
            <button hx-delete="/api/subscriptions/{{ subscription_id }}" hx-swap="none"
                    hx-confirm="Unsubscribe this gallery?"
                    hx-on:htmx:afterRequest="window._subToggle(event)"
                    class="px-4 py-2 bg-yellow-100 text-yellow-800 text-sm rounded-lg hover:bg-yellow-200 border border-yellow-300"
                    title="Stop watching this gallery for new versions">
                Subscribed &#10003;
            </button>
            {% else %}
            <button hx-post="/api/subscriptions" hx-ext="json-enc" hx-vals='{"url":"{{ url }}"}' hx-swap="none"
                    hx-on:htmx:afterRequest="window._subToggle(event)"
                    class="px-4 py-2 bg-blue-50 text-blue-700 text-sm rounded-lg hover:bg-blue-100 border border-blue-200"
                    title="Watch this gallery and auto-download newer versions">
                Subscribe
            </button>
            {% endif %}
        </div>
    </div>

    <!-- Progress / Completion -->
    <div class="bg-white rounded-lg shadow-sm border p-6">
        {% if state == 20 %}
        <h2 class="text-lg font-semibold mb-1">Completed</h2>
        <p class="text-sm text-gray-500">{{ done }}/{{ total }} images &middot; {{ finished_at }}</p>
        {% else %}
        <h2 class="text-lg font-semibold mb-3">Progress</h2>
        <div id="progress-area">
            {{ progress_bar(done, total) }}
        </div>
        {% endif %}
    </div>

    <!-- Tags -->
    {% if tag_groups %}
    <div class="bg-white rounded-lg shadow-sm border p-6">
        <h2 class="text-lg font-semibold mb-3">Tags</h2>
        {% set _cat_order = ["language","parody","character","cosplayer","group","artist","male","female","mixed","other"] %}
        {% for cat in _cat_order %}
        {% set items = tag_groups.get(cat, []) %}
        {% if items %}
        <div class="mb-3">
            <span class="text-xs font-semibold uppercase text-gray-400 tracking-wider">{{ cat }}</span>
            <div class="flex flex-wrap gap-1.5 mt-1">
                {% for item in items %}
                <a href="/tasks?f_search={{ item.search }}"
                   title="Search tasks with tag: {{ item.label }}"
                   class="inline-flex items-center px-2 py-0.5 rounded text-xs font-medium bg-gray-100 text-gray-700 hover:bg-blue-50 hover:text-blue-700 hover:border-blue-200 border border-transparent">
                    {{ item.label }}
                </a>
                {% endfor %}
            </div>
        </div>
        {% endif %}
        {% endfor %}
    </div>
    {% endif %}

    {% if newer_versions %}
    <div class="bg-yellow-50 border border-yellow-200 rounded-lg p-4">
        <h3 class="text-sm font-semibold text-yellow-800">Newer Versions Available</h3>
        <ul class="mt-2 space-y-1">
            {% for nv in newer_versions %}
            <li class="text-sm text-yellow-700">
                {% if nv.guid %}
                <a href="/tasks/{{ nv.guid }}" class="text-blue-600 hover:underline">{{ nv.title or nv.gid }}</a>
                {% else %}
                {{ nv.title or nv.url }}
                {% endif %}
                (added: {{ nv.added }})
            </li>
            {% endfor %}
        </ul>
    </div>
    {% endif %}

    <!-- Image Grid -->
    {% if all_images %}
    <div class="bg-white rounded-lg shadow-sm border p-6">
        <h2 class="text-lg font-semibold mb-4">Images ({{ total }})</h2>
        {% include "task_images.html.j2" %}
        {% if total > 18 %}
        <a href="/tasks/{{ guid }}/read/1" class="inline-block mt-4 text-sm text-blue-600 hover:text-blue-800">
            View all {{ total }} images in reader &rarr;
        </a>
        {% endif %}
    </div>
    {% elif total > 0 %}
    <div class="bg-white rounded-lg shadow-sm border p-6">
        <h2 class="text-lg font-semibold mb-4">Images</h2>
        <p class="text-gray-400 text-sm">Images will appear here as they are downloaded.</p>
    </div>
    {% endif %}
</div>
{% endblock %}

{% block scripts %}
<script>
initWebSocket();

// Subscribe / Unsubscribe button handler: reload on success, toast on failure.
window._subToggle = function(e) {
    if (e.detail.successful) {
        window.location.reload();
    } else {
        var detail = "";
        try { detail = JSON.parse(e.detail.xhr.responseText).detail || ""; } catch (err) {}
        showToast("Subscription action failed: " + (detail || ("HTTP " + e.detail.xhr.status)), "error");
    }
};

// Listen for task progress updates to this specific task
window.addEventListener("ws:task_progress", function(e) {
    if (e.detail && e.detail.guid === "{{ guid }}") {
        // Refresh progress
        const pct = e.detail.total > 0 ? Math.round(e.detail.done / e.detail.total * 100) : 0;
        const bar = document.querySelector("#progress-area .bg-blue-600");
        if (bar) bar.style.width = pct + "%";
        const label = document.querySelector("#progress-area span");
        if (label) label.textContent = e.detail.done + "/" + e.detail.total + " (" + pct + "%)";
        // Reload page on completion
        if (e.detail.state === 20 || e.detail.state < 0) {
            setTimeout(function() { location.reload(); }, 1000);
        }
    }
});
</script>
{% endblock %}
